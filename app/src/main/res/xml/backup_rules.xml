<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Android-12 counterpart to data_extraction_rules.xml. Backup is already off
     via android:allowBackup="false"; this makes the intent explicit for API 29-30. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
