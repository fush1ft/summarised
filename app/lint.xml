<?xml version="1.0" encoding="utf-8"?>
<lint>
    <!-- These fire whenever a dependency publishes a new release, which would turn
         CI red without a single line of code changing. Dependency updates are a
         deliberate, reviewed action here, not a build failure. -->
    <issue id="GradleDependency" severity="ignore" />
    <issue id="AndroidGradlePluginVersion" severity="ignore" />

    <!-- Lint reads the v26 qualifier as a minSdk guard and suggests dropping it.
         It is not one: the adaptive-icon XML format itself is API 26+, and AAPT2
         silently declines to merge the folder without the qualifier, which breaks
         the launcher icon outright. Verified by building both ways. -->
    <issue id="ObsoleteSdkInt">
        <ignore path="src/main/res/mipmap-anydpi-v26" />
    </issue>

    <!-- The UI is Czech-only for now and its text lives in code on purpose;
         localisation is a later milestone. -->
    <issue id="SetTextI18n" severity="ignore" />
    <!-- Numbers are formatted in the user's locale deliberately (decimal comma in Czech). -->
    <issue id="DefaultLocale" severity="ignore" />
    <!-- The digital-assistant picker only lists apps that export a recognition
         service; ours is a stub that answers every request with an error. -->
    <issue id="ExportedService">
        <ignore path="src/main/AndroidManifest.xml" />
    </issue>

    <!-- The on-device inference core is built for arm64 only on purpose: the
         app targets ARM phones, and an x86_64 build of llama.cpp/whisper.cpp
         would double the native build and APK size for no user. -->
    <issue id="ChromeOsAbiSupport" severity="ignore" />
</lint>
